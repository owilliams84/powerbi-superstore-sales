			            "<text x='98' y='121' font-size='17' font-weight='700' text-anchor='middle' fill='" & Fg & "'>" & SWITCH(TRUE(), V >= 1000000, "$" & FORMAT(V / 1000000, "0.00") & "M", V >= 10000, "$" & FORMAT(V / 1000, "0.0") & "k", V >= 1000, "$" & FORMAT(V / 1000, "0.00") & "k", "$" & FORMAT(V, "0")) & "</text>"
			                & "<text x='188' y='222' font-size='10.5' text-anchor='end' fill='" & Fg & "' opacity='0.8'>" & FORMAT(N, "#,0") & IF(N = 1, " order", " orders") & "</text>"
