	/// One calendar cell at the Year grain, drawn at 196x230: label top left, sales in the
	/// middle, orders bottom right, on the band's colour. A cell with no sales shows a dash.
	measure 'Cal Cell Year' =
			VAR Band = [Cal Band Year]
			VAR V = [Sales]
			VAR N = [Orders]
			VAR Fg = SWITCH(TRUE(), Band = 0, "#667284", Band >= 3, "#FFFFFF", "#0A0917")
