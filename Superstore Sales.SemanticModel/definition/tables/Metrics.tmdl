/// Measure-only table. Nothing here stores data; the hidden column exists because a
/// table needs one. Every number on the report comes from here.
table Metrics
	lineageTag: 71f3b6af-c7b4-5d1d-be95-d5774cf079be

	measure Sales = SUM(Sales[Sales])
		formatString: \$#,0
		lineageTag: 0a7b2c99-6fed-5c9b-ac4e-3595c8519a3c

	measure 'Order Lines' = COUNTROWS(Sales)
		formatString: #,0
		lineageTag: cc6bddcc-62c8-51d3-bd74-1585b673a9c7

	/// Distinct orders, not lines. An order averages two lines, so counting rows overstates it.
	measure Orders = DISTINCTCOUNT(Sales[Order ID])
		formatString: #,0
		lineageTag: b7143815-19ae-57a1-9ce5-82c973e3367e

	/// Customers with at least one order in the period. Counted on the fact so every filter -
	/// product, region, ship mode - narrows it.
	measure Customers = DISTINCTCOUNT(Sales[Customer ID])
		formatString: #,0
		lineageTag: be2c4170-9dcf-5525-8f8c-685fd70c5c6c

	measure 'Products Sold' = DISTINCTCOUNT(Sales[Product Key])
		formatString: #,0
		lineageTag: 8ae6b8d3-6dfc-5d7b-b746-aa1059f3d034

	measure 'Average Order Value' = DIVIDE([Sales], [Orders])
		formatString: \$#,0
		lineageTag: 2896589e-4129-5506-af42-d101133313ec

	measure 'Average Line Value' = DIVIDE([Sales], [Order Lines])
		formatString: \$#,0.00
		lineageTag: 8d0b26b1-c13e-59d2-8390-d45bb3d10060

	measure 'Sales per Customer' = DIVIDE([Sales], [Customers])
		formatString: \$#,0
		lineageTag: 55cc41b5-f242-5ed2-98d4-c5cac097709b

	measure 'Orders per Customer' = DIVIDE([Orders], [Customers])
		formatString: 0.00
		lineageTag: c7b3f142-b461-5636-ad10-ebe8ac06fd93

	measure 'Lines per Order' = DIVIDE([Order Lines], [Orders])
		formatString: 0.00
		lineageTag: 55fb0751-c457-5dbc-856f-f06bb0e72b38

	/// The same period a year earlier. Needs the marked date table - without it DATEADD returns
	/// blank for every row and the YoY column looks like 2021 forever.
	measure 'Sales PY' = CALCULATE([Sales], DATEADD('Date'[Date], -1, YEAR))
		formatString: \$#,0
		lineageTag: 49530253-bcbb-5460-9974-e96146d891df

	/// Blank in 2021, the first year, rather than a meaningless comparison to nothing.
	measure 'Sales YoY %' = DIVIDE([Sales] - [Sales PY], [Sales PY])
		formatString: 0.0%
		lineageTag: 5b16003f-a9e6-5e89-bbf9-3f0d90244748

	measure 'Orders PY' = CALCULATE([Orders], DATEADD('Date'[Date], -1, YEAR))
		formatString: #,0
		lineageTag: cd34da6a-5a90-535d-9910-217dc2e5b829

	measure 'Orders YoY %' = DIVIDE([Orders] - [Orders PY], [Orders PY])
		formatString: 0.0%
		lineageTag: 4b773bd6-29b5-5e8e-983e-2c9925d2184c

	measure 'Customers PY' = CALCULATE([Customers], DATEADD('Date'[Date], -1, YEAR))
		formatString: #,0
		lineageTag: 73b28a8a-43e6-575d-965f-e037da4d3be8

	measure 'Customers YoY %' = DIVIDE([Customers] - [Customers PY], [Customers PY])
		formatString: 0.0%
		lineageTag: 76568e9d-c52b-5f2f-b882-44350e5f4b5f

	measure 'Sales YTD' = TOTALYTD([Sales], 'Date'[Date])
		formatString: \$#,0
		lineageTag: 4c07501f-d9d0-51c6-96f7-e7a85edd6a98

	/// Rolling twelve months to the end of the period - the only volume figure that compares
	/// like with like when the year on screen is not a full one.
	measure 'Sales 12M' = CALCULATE([Sales], DATESINPERIOD('Date'[Date], MAX('Date'[Date]), -12, MONTH))
		formatString: \$#,0
		lineageTag: 40f1dda6-98e0-5a0c-8505-d9cb9d1a3cf3

	/// This row's share of all sales in the same period. Every non-date filter is cleared, so a
	/// sub-category's share is of the whole company, not of its category.
	measure 'Sales Share' =
			DIVIDE(
			    [Sales],
			    CALCULATE(
			        [Sales],
			        REMOVEFILTERS('Product'), REMOVEFILTERS('Customer'),
			        REMOVEFILTERS('Geography'), REMOVEFILTERS('Ship Mode')
			    )
			)
		formatString: 0.0%
		lineageTag: 095aff6f-8d80-567c-b720-b28230731413

	/// Share of whatever is on the visual, for a 100% breakdown inside a filtered view.
	measure 'Sales Share of Selection' = DIVIDE([Sales], CALCULATE([Sales], ALLSELECTED()))
		formatString: 0.0%
		lineageTag: 2c433529-9e34-5a94-ba97-2d150b1f8f82

	/// Pareto line over sub-categories: the share of sales from this sub-category and every one
	/// selling more than it. Reads left to right on a chart sorted by sales.
	measure 'Cumulative Sales Share' =
			VAR ThisSales = [Sales]
			VAR Total = CALCULATE([Sales], ALLSELECTED('Product'[Sub-Category]))
			VAR Above =
			    SUMX(
			        FILTER(ALLSELECTED('Product'[Sub-Category]), [Sales] >= ThisSales),
			        [Sales]
			    )
			RETURN
			    DIVIDE(Above, Total)
		formatString: 0.0%
		lineageTag: 147b708a-d6ad-5c3e-bae9-4a1019f3faeb

	measure 'Product Rank' = RANKX(ALLSELECTED('Product'), [Sales], , DESC, Dense)
		formatString: 0
		lineageTag: 88ab2f53-63ee-5acf-af8e-4e8c8a92755a

	measure 'Customer Rank' = RANKX(ALLSELECTED('Customer'), [Sales], , DESC, Dense)
		formatString: 0
		lineageTag: 25e9d4fc-a845-5c11-b2c2-4487399e9842

	measure 'State Rank' = RANKX(ALLSELECTED('Geography'[State]), [Sales], , DESC, Dense)
		formatString: 0
		lineageTag: c64b6743-1d6c-51c3-8c87-78683a146c8a

	/// Customers whose first ever order falls in the period. Because it filters the fact rather
	/// than counting the Customer table, a product or region on the visual still applies: it
	/// becomes 'new customers who bought this'.
	measure 'New Customers' =
			VAR PeriodStart = MIN('Date'[Date])
			VAR PeriodEnd = MAX('Date'[Date])
			RETURN
			    CALCULATE([Customers], FILTER(
			        ALL(Customer[First Order Date]),
			        Customer[First Order Date] >= PeriodStart && Customer[First Order Date] <= PeriodEnd
			    ))
		formatString: #,0
		lineageTag: b001772e-1237-5f4d-a429-48c0a27d5b17

	/// Customers active in the period whose first order was before it.
	measure 'Returning Customers' = [Customers] - [New Customers]
		formatString: #,0
		lineageTag: 31562bb7-d56b-5a2d-8a82-dbef9a47b51e

	measure 'New Customer Share' = DIVIDE([New Customers], [Customers])
		formatString: 0.0%
		lineageTag: 5d494c15-99ef-59e3-a099-58e5e90f64e1

	measure 'Sales from New Customers' =
			VAR PeriodStart = MIN('Date'[Date])
			VAR PeriodEnd = MAX('Date'[Date])
			RETURN
			    CALCULATE([Sales], FILTER(
			        ALL(Customer[First Order Date]),
			        Customer[First Order Date] >= PeriodStart && Customer[First Order Date] <= PeriodEnd
			    ))
		formatString: \$#,0
		lineageTag: b5925092-9055-5a24-a920-d5b8b578d3af

	measure 'Sales from Returning Customers' = [Sales] - [Sales from New Customers]
		formatString: \$#,0
		lineageTag: 8336abfe-abde-583a-9b15-1b077780b7a0

	measure 'Returning Sales Share' = DIVIDE([Sales from Returning Customers], [Sales])
		formatString: 0.0%
		lineageTag: 50a4a268-f689-5cdb-8fbb-c8257b7ee0cd

	/// Share of active customers who ordered at least twice in the period.
	measure 'Repeat Customer Share' =
			VAR PerCustomer =
			    ADDCOLUMNS(VALUES(Sales[Customer ID]), "@Orders", CALCULATE(DISTINCTCOUNT(Sales[Order ID])))
			RETURN
			    DIVIDE(COUNTROWS(FILTER(PerCustomer, [@Orders] >= 2)), [Customers])
		formatString: 0.0%
		lineageTag: bf78fc1f-cdbf-5e4b-a0f9-fafe2522b1a3

	/// Customers with at least one order in every year of the period. With one year selected
	/// it equals active customers, which is the right answer to the question it then asks.
	/// Counted through SUMMARIZE on the fact: DISTINCTCOUNT on the Date table would return
	/// the whole calendar for every customer, because a fact cannot filter its dimension.
	measure 'Customers Active Every Year' =
			VAR YearsInPeriod = COUNTROWS(VALUES('Date'[Year]))
			RETURN
			    COUNTROWS(
			        FILTER(
			            VALUES(Sales[Customer ID]),
			            CALCULATE(COUNTROWS(SUMMARIZE(Sales, 'Date'[Year]))) = YearsInPeriod
			        )
			    )
		formatString: #,0
		lineageTag: 7f7132bc-71f8-5230-8388-d5bcf05b09fe

	/// Every customer in the cohort on the row, whatever year the column is - the denominator
	/// for retention.
	measure 'Cohort Size' = CALCULATE([Customers], REMOVEFILTERS('Date'))
		formatString: #,0
		lineageTag: 0a4baacc-5f66-563f-b359-44d66a350180

	/// On a cohort-by-year matrix: the share of a cohort that ordered again in each year. The
	/// cohort's own year is 100% by definition, and years before it are blank.
	measure 'Retention %' = DIVIDE([Customers], [Cohort Size])
		formatString: 0.0%
		lineageTag: 009d2da3-3c40-5816-b8ef-10891501a6f9

	/// Calendar days from order to ship, averaged over order lines.
	measure 'Average Ship Days' = AVERAGE(Sales[Ship Days])
		formatString: 0.0
		lineageTag: a4f838aa-7eef-5374-883c-624c3c29b2ff

	/// Share of orders, not sales, so a single large Same Day order does not dominate.
	measure 'Ship Mode Share' = DIVIDE([Orders], CALCULATE([Orders], REMOVEFILTERS('Ship Mode')))
		formatString: 0.0%
		lineageTag: a96449c6-dc39-569e-be36-d589bfa58dca

	/// KEEPFILTERS matters: without it the filter would overwrite a ship mode already on the
	/// visual and repeat the grand total down a breakdown.
	measure 'Standard Class Share' = DIVIDE(CALCULATE([Orders], KEEPFILTERS('Ship Mode'[Ship Mode] = "Standard Class")), [Orders])
		formatString: 0.0%
		lineageTag: ccc38c5d-366f-5f3d-8c20-f3e777e5db1f

	/// A label for the period on screen: '2024', '2021 to 2024', or 'Mar 2023 to Jun 2023'.
	measure 'Report Period' =
			VAR First = MIN('Date'[Date])
			VAR Last = MAX('Date'[Date])
			VAR WholeYears = MONTH(First) = 1 && DAY(First) = 1 && MONTH(Last) = 12 && DAY(Last) = 31
			RETURN
			    SWITCH(
			        TRUE(),
			        WholeYears && YEAR(First) = YEAR(Last), FORMAT(Last, "yyyy"),
			        WholeYears, FORMAT(First, "yyyy") & " to " & FORMAT(Last, "yyyy"),
			        FORMAT(First, "mmm yyyy") & " to " & FORMAT(Last, "mmm yyyy")
			    )
		lineageTag: 73592538-bb7e-524f-9ceb-66e617c44503

	measure 'Period End Label' = FORMAT(MAX('Date'[Date]), "mmmm yyyy")
		lineageTag: e10302ff-48a8-5b81-971b-ff8f2e280680

	measure 'Latest Order Date' = MAX(Sales[Order Date])
		formatString: d mmm yyyy
		lineageTag: 93029cc6-af25-5510-89a2-8bad0931c660

	/// 1 for the prior year, 2 for two years earlier. Defaults to 1 with nothing selected.
	measure 'Comparison Years Back' = SELECTEDVALUE(Comparison[Years Back], 1)
		formatString: 0
		displayFolder: Revenue page
		lineageTag: d4b4f548-8f68-5e4e-88ff-28496ecc1770

	/// The year on screen. The page forces a single year, so MAX is that year.
	measure 'Selected Year' = MAX('Date'[Year])
		formatString: 0
		displayFolder: Revenue page
		lineageTag: c8d50aa7-1476-5d87-bf50-37cf2acb50fd

	measure 'Comparison Year' = [Selected Year] - [Comparison Years Back]
		formatString: 0
		displayFolder: Revenue page
		lineageTag: 9c0c57df-43c8-5c2f-aa3e-e66830c2c9ac

	/// False when the comparison year is before the calendar starts - 2022 against two years
	/// earlier. Everything comparative returns blank rather than a change against nothing.
	measure 'Comparison Available' = [Comparison Year] >= CALCULATE(MIN('Date'[Year]), REMOVEFILTERS('Date'))
		displayFolder: Revenue page
		lineageTag: 35941fe4-ae28-5b18-bc65-af7a91f1d348

	/// Sales in the same dates, one or two years earlier. DATEADD takes the offset from a
	/// variable, so one measure serves both buttons.
	measure 'Sales Comparison' =
			VAR YearsBack = [Comparison Years Back]
			RETURN
			    IF([Comparison Available], CALCULATE([Sales], DATEADD('Date'[Date], -YearsBack, YEAR)))
		formatString: \$#,0
		displayFolder: Revenue page
		lineageTag: f138255a-7696-5a74-8853-a0c53c6facbf

	measure 'Sales vs Comparison' = IF([Comparison Available], [Sales] - [Sales Comparison])
		formatString: \$#,0
		displayFolder: Revenue page
		lineageTag: d7ba8874-17e6-5789-b5ad-145f27e9a9e6

	measure 'Sales vs Comparison %' = DIVIDE([Sales vs Comparison], [Sales Comparison])
		formatString: 0.0%
		displayFolder: Revenue page
		lineageTag: 0ef6c047-9c52-5fc1-a345-5129be7f07b4

	measure 'Orders Comparison' =
			VAR YearsBack = [Comparison Years Back]
			RETURN
			    IF([Comparison Available], CALCULATE([Orders], DATEADD('Date'[Date], -YearsBack, YEAR)))
		formatString: #,0
		displayFolder: Revenue page
		lineageTag: e793e576-c17c-5dc2-9ae0-6512e400c21f

	measure 'Orders vs Comparison %' = DIVIDE([Orders] - [Orders Comparison], [Orders Comparison])
		formatString: 0.0%
		displayFolder: Revenue page
		lineageTag: b06b799d-1c0f-5b21-b890-e0b55c7400b0

	measure 'Average Order Value Comparison' = DIVIDE([Sales Comparison], [Orders Comparison])
		formatString: \$#,0
		displayFolder: Revenue page
		lineageTag: 8694b70f-9650-5c2e-a15b-67968f3f42a1

	measure 'Average Order Value vs Comparison %' = DIVIDE([Average Order Value] - [Average Order Value Comparison], [Average Order Value Comparison])
		formatString: 0.0%
		displayFolder: Revenue page
		lineageTag: 3ac2b687-32c9-518f-9d97-7f7865ab0f18

	measure 'Line View Selected' = SELECTEDVALUE('Line View'[View], "Month")
		displayFolder: Revenue page
		lineageTag: 43c0db67-4792-54bb-8c27-fc288af8a8d6

	/// The selected year on the line chart: each month, or the running total to that month.
	measure 'Sales Line' = IF([Line View Selected] = "Cumulative", CALCULATE([Sales], DATESYTD('Date'[Date])), [Sales])
		formatString: \$#,0
		displayFolder: Revenue page
		lineageTag: ba2d4889-7893-51e8-85ae-60cfe98dbac0

	measure 'Comparison Line' =
			VAR YearsBack = [Comparison Years Back]
			RETURN
			    IF(
			        [Comparison Available],
			        IF(
			            [Line View Selected] = "Cumulative",
			            CALCULATE([Sales YTD], DATEADD('Date'[Date], -YearsBack, YEAR)),
			            [Sales Comparison]
			        )
			    )
		formatString: \$#,0
		displayFolder: Revenue page
		lineageTag: 9b9b2e64-6bb5-5a52-9918-8cd591b362a2

	/// Fill for the monthly variance columns, bound as a field value.
	measure 'Variance Colour' = IF([Sales vs Comparison] >= 0, "#1E7A4C", "#B3261E")
		displayFolder: Revenue page
		lineageTag: 1dd2d246-1acc-57d2-9fd1-29355376dbbd

	/// Customers who bought in the selected year, the comparison year, or both.
	measure 'Customers In Play' = IF([Comparison Available], COUNTROWS(FILTER(ALL(Customer[Customer]), [Sales] + [Sales Comparison] > 0)))
		formatString: #,0
		displayFolder: Revenue page
		lineageTag: df3e6e89-2b5a-52bb-9324-9db98ed489c2

	/// Customers whose sales beat the comparison year, including customers new since.
	measure 'Customers Above Comparison' = IF([Comparison Available], COUNTROWS(FILTER(ALL(Customer[Customer]), [Sales] > [Sales Comparison])))
		formatString: #,0
		displayFolder: Revenue page
		lineageTag: f3943c39-b84c-5a87-a035-679926b44c21

	/// ALLSELECTED, not ALL: Region is on the filter panel, and ALL would count all four regions
	/// under a West filter.
	measure 'Regions Above Comparison' = IF([Comparison Available], COUNTROWS(FILTER(ALLSELECTED(Geography[Region]), [Sales] > [Sales Comparison])))
		formatString: #,0
		displayFolder: Revenue page
		lineageTag: 94f217e9-7bdf-516b-852a-1ccd676e0b24

	measure 'Sub-categories In Play' = IF([Comparison Available], COUNTROWS(FILTER(ALL(Product[Sub-Category]), [Sales] + [Sales Comparison] > 0)))
		formatString: #,0
		displayFolder: Revenue page
		lineageTag: 0e410c11-b8b4-5d05-93b3-f33602808390

	measure 'Sub-categories Above Comparison' = IF([Comparison Available], COUNTROWS(FILTER(ALL(Product[Sub-Category]), [Sales] > [Sales Comparison])))
		formatString: #,0
		displayFolder: Revenue page
		lineageTag: ee468628-e9a5-541b-a116-65d0c066c469

	/// The change as text for the ranked tables: 'new' where there was nothing to compare with,
	/// and capped at >+999% so a customer who went from $27 to $5,821 does not read 21268%.
	measure 'Sales vs Comparison % Label' =
			VAR P = [Sales vs Comparison %]
			RETURN
			    IF(
			        [Comparison Available] && [Sales] + [Sales Comparison] > 0,
			        SWITCH(
			            TRUE(),
			            ISBLANK(P), "new",
			            P >= 10, ">+999%",
			            FORMAT(P, "+0.0%;-0.0%;0.0%")
			        )
			    )
		displayFolder: Revenue page
		lineageTag: c7f36afa-c01f-565b-8e69-01f64f9073ff

	measure 'Title Variance Chart' = IF([Comparison Available], "Which months beat " & [Comparison Year] & ", and by how much", "Which months moved the year")
		displayFolder: Revenue page
		lineageTag: 523576be-9c24-551b-8860-126305616c9e

	/// Position by change on the comparison year, from the top or the bottom as the
	/// 'Customer Ranking' button says. Blank for anything that sold in neither year. The table
	/// keeps ranks 1 to 8 with a visual-level filter on this measure.
	measure 'Customer Change Rank' =
			VAR Direction = SELECTEDVALUE('Customer Ranking'[Show], "Top")
			VAR Pool = FILTER(ALL(Customer[Customer]), [Sales] + [Sales Comparison] > 0)
			VAR Me = [Sales vs Comparison]
			RETURN
			    IF(
			        HASONEVALUE(Customer[Customer]) && [Comparison Available] && [Sales] + [Sales Comparison] > 0,
			        IF(
			            Direction = "Top",
			            COUNTROWS(FILTER(Pool, [Sales vs Comparison] > Me)) + 1,
			            COUNTROWS(FILTER(Pool, [Sales vs Comparison] < Me)) + 1
			        )
			    )
		formatString: 0
		displayFolder: Revenue page
		lineageTag: ce3e74a2-b79c-593a-afff-44269deea33d

	/// Diverging bar for the change. Every row shares one scale - the largest move either way
	/// in the pool - so a Top and a Bottom view can be compared by eye.
	measure 'Customer Change Bar' =
			VAR Change = [Sales vs Comparison]
			VAR Scale = MAXX(FILTER(ALL(Customer[Customer]), [Sales] + [Sales Comparison] > 0), ABS([Sales vs Comparison]))
			VAR W = DIVIDE(ABS(Change), Scale) * 76
			VAR X = IF(Change >= 0, 80, 80 - W)
			VAR Svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='160' height='16' viewBox='0 0 160 16'>"
			        & "<line x1='80' y1='0' x2='80' y2='16' stroke='#667284'/>"
			        & "<rect x='" & FORMAT(X, "0.0") & "' y='3' width='" & FORMAT(W, "0.0") & "' height='10' fill='" & IF(Change >= 0, "#1E7A4C", "#B3261E") & "'/>"
			        & "</svg>"
			RETURN
			    IF(NOT ISBLANK([Customer Change Rank]), "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(Svg, "%", "%25"), "#", "%23"))
		displayFolder: Revenue page
		dataCategory: ImageUrl
		lineageTag: 961d714e-4bfd-57bb-9369-fb3034951279

	/// Position by change on the comparison year, from the top or the bottom as the
	/// 'Sub-category Ranking' button says. Blank for anything that sold in neither year. The table
	/// keeps ranks 1 to 8 with a visual-level filter on this measure.
	measure 'Sub-category Change Rank' =
			VAR Direction = SELECTEDVALUE('Sub-category Ranking'[Show], "Top")
			VAR Pool = FILTER(ALL(Product[Sub-Category]), [Sales] + [Sales Comparison] > 0)
			VAR Me = [Sales vs Comparison]
			RETURN
			    IF(
			        HASONEVALUE(Product[Sub-Category]) && [Comparison Available] && [Sales] + [Sales Comparison] > 0,
			        IF(
			            Direction = "Top",
			            COUNTROWS(FILTER(Pool, [Sales vs Comparison] > Me)) + 1,
			            COUNTROWS(FILTER(Pool, [Sales vs Comparison] < Me)) + 1
			        )
			    )
		formatString: 0
		displayFolder: Revenue page
		lineageTag: 41274e4b-a5de-526e-9999-856c4fb645d6

	/// Diverging bar for the change. Every row shares one scale - the largest move either way
	/// in the pool - so a Top and a Bottom view can be compared by eye.
	measure 'Sub-category Change Bar' =
			VAR Change = [Sales vs Comparison]
			VAR Scale = MAXX(FILTER(ALL(Product[Sub-Category]), [Sales] + [Sales Comparison] > 0), ABS([Sales vs Comparison]))
			VAR W = DIVIDE(ABS(Change), Scale) * 76
			VAR X = IF(Change >= 0, 80, 80 - W)
			VAR Svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='160' height='16' viewBox='0 0 160 16'>"
			        & "<line x1='80' y1='0' x2='80' y2='16' stroke='#667284'/>"
			        & "<rect x='" & FORMAT(X, "0.0") & "' y='3' width='" & FORMAT(W, "0.0") & "' height='10' fill='" & IF(Change >= 0, "#1E7A4C", "#B3261E") & "'/>"
			        & "</svg>"
			RETURN
			    IF(NOT ISBLANK([Sub-category Change Rank]), "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(Svg, "%", "%25"), "#", "%23"))
		displayFolder: Revenue page
		dataCategory: ImageUrl
		lineageTag: a915fdf0-8023-51e0-a6b3-04ba8b44ab76

	/// The page standfirst, rewritten for whatever year and comparison is selected.
	measure 'Title Standfirst' =
			VAR Y = [Selected Year]
			VAR C = [Comparison Year]
			VAR S = [Sales vs Comparison %]
			VAR O = [Orders vs Comparison %]
			VAR A = [Average Order Value vs Comparison %]
			VAR Moved = S >= 0
			RETURN
			    IF(
			        NOT [Comparison Available],
			        "There are no sales before 2021, so " & Y & " has no " & C & " sales to compare with. Pick a later year or the prior year.",
			        Y & " sales were " & IF(Moved, "up ", "down ") & FORMAT(ABS(S), "0.0%") & " on " & C & ". Orders "
			            & IF(O >= 0, "rose ", "fell ") & FORMAT(ABS(O), "0.0%") & " and the average order "
			            & IF(A >= 0, "rose ", "fell ") & FORMAT(ABS(A), "0.0%") & ": the change came from "
			            & IF(ABS(O) > ABS(A), "the number of orders, not their size.", "order size more than order count.")
			    )
		displayFolder: Revenue page
		lineageTag: 8af09937-1687-5b69-94cb-0bb38452f7a2

	measure 'Title Line Chart' =
			IF(
			    [Comparison Available],
			    [Selected Year] & " against " & [Comparison Year]
			        & IF([Line View Selected] = "Cumulative", ", running total", ", month by month"),
			    [Selected Year] & ", with no comparison year"
			)
		displayFolder: Revenue page
		lineageTag: 66233182-25ed-55aa-90b2-25a46fafc8b4

	measure 'Subtitle Line Chart' =
			VAR C = [Comparison Year]
			VAR MonthsAbove = COUNTROWS(FILTER(VALUES('Date'[Month No]), [Sales vs Comparison] > 0))
			VAR Gap = [Sales vs Comparison]
			RETURN
			    IF(
			        [Comparison Available],
			        IF(
			            [Line View Selected] = "Cumulative",
			            FORMAT(ABS(Gap), "$#,0") & IF(Gap >= 0, " ahead of ", " behind ") & C & " by the year end",
			            "Above " & C & " in " & MonthsAbove & " of " & COUNTROWS(VALUES('Date'[Month No])) & " months"
			        )
			    )
		displayFolder: Revenue page
		lineageTag: ac3411f1-98d5-5ed9-90f5-8d1bb73de570

	measure 'Subtitle Variance Chart' =
			VAR ByMonth = ADDCOLUMNS(VALUES('Date'[Month No]), "@Change", [Sales vs Comparison])
			VAR Best = TOPN(1, ByMonth, [@Change], DESC)
			VAR Worst = TOPN(1, ByMonth, [@Change], ASC)
			VAR BestMonth = FORMAT(DATE(2000, MAXX(Best, 'Date'[Month No]), 1), "mmm")
			VAR WorstMonth = FORMAT(DATE(2000, MAXX(Worst, 'Date'[Month No]), 1), "mmm")
			VAR BestValue = MAXX(Best, [@Change])
			VAR WorstValue = MAXX(Worst, [@Change])
			RETURN
			    IF(
			        [Comparison Available],
			        "Sales less " & [Comparison Year] & ": " & BestMonth & " added most ("
			            & IF(BestValue < 0, "-", "+") & FORMAT(ABS(BestValue), "$#,0") & "), "
			            & WorstMonth & IF(WorstValue < 0, " lost most (-", " added least (+") & FORMAT(ABS(WorstValue), "$#,0") & ")"
			    )
		displayFolder: Revenue page
		lineageTag: 5596f525-2154-57f7-b677-4177c7efff0c

	measure 'Title Customer Table' =
			IF(
			    SELECTEDVALUE('Customer Ranking'[Show], "Top") = "Top",
			    "The 8 customers who grew most on " & [Comparison Year],
			    "The 8 customers who fell furthest below " & [Comparison Year]
			)
		displayFolder: Revenue page
		lineageTag: 45570ca4-8edf-5ed8-8781-3ccbb28e28a8

	measure 'Subtitle Customer Table' =
			IF(
			    [Comparison Available],
			    "Bars share one scale: the largest move either way among " & FORMAT([Customers In Play], "#,0") & " customers"
			)
		displayFolder: Revenue page
		lineageTag: 39af6aec-4395-5245-a00d-9bc65dd9772f

	measure 'Title Sub-category Table' =
			IF(
			    SELECTEDVALUE('Sub-category Ranking'[Show], "Top") = "Top",
			    "The 8 sub-categories that grew most on " & [Comparison Year],
			    "The 8 sub-categories that did worst against " & [Comparison Year]
			)
		displayFolder: Revenue page
		lineageTag: 79081212-3ad9-5a84-9caf-02151b1205a6

	measure 'Subtitle Sub-category Table' =
			IF(
			    [Comparison Available],
			    [Sub-categories In Play] - [Sub-categories Above Comparison] & " of " & [Sub-categories In Play]
			        & " were below " & [Comparison Year]
			)
		displayFolder: Revenue page
		lineageTag: bd81ed3d-3039-5492-8765-a10ca885314c

	/// Shown under the Filters button so a closed panel still says what it is doing.
	measure 'Filter Summary' =
			VAR Names =
			    FILTER(
			        {
			            ("segment", ISFILTERED(Customer[Segment]), 1),
			            ("region", ISFILTERED(Geography[Region]), 2),
			            ("category", ISFILTERED(Product[Category]), 3)
			        },
			        [Value2]
			    )
			RETURN
			    IF(
			        COUNTROWS(Names) = 0,
			        "No filters applied",
			        "Filtered by " & CONCATENATEX(Names, [Value1], ", ", [Value3], ASC)
			    )
		displayFolder: Revenue page
		lineageTag: 272dd9a9-223f-5bff-b998-9dd6d4d5cbb9

	/// KPI card as one SVG: sales, the change on the comparison year, and a ring showing sales
	/// as a share of the comparison, the part above 100% in gold.
	measure 'Card Sales' =
			VAR Y = [Selected Year]
			VAR C = [Comparison Year]
			VAR S = [Sales]
			VAR SC = [Sales Comparison]
			VAR SP = [Sales vs Comparison %]
			VAR OP = [Orders vs Comparison %]
			VAR AP = [Average Order Value vs Comparison %]
			VAR Ratio = DIVIDE(S, SC)
			VAR Svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='336' height='140' viewBox='0 0 336 140' font-family='Segoe UI, sans-serif'>"
			    & "<rect x='0.5' y='0.5' width='335' height='139' rx='4' fill='#FFFFFF' stroke='#E3E7EF'/><rect width='3' height='140' fill='#C9A227'/>"
			    & "<text x='16' y='24' font-size='11' font-weight='700' fill='#667284' letter-spacing='0.4'>" & "SALES, " & Y & "</text>"
			    & "<text x='16' y='58' font-size='28' font-weight='700' fill='#0A0917'>" & "$" & FORMAT(S, "#,0") & "</text>"
			    & "<text x='16' y='76' font-size='11.5' fill='#667284'>" & IF(ISBLANK(SP), "new", IF(ABS(SP) >= 10, IF(SP > 0, ">+999%", "<-999%"), IF(SP < 0, "&#8722;", "+") & FORMAT(ABS(SP), "0.0%"))) & " on " & C & " (" & "$" & FORMAT(SC, "#,0") & ")" & "</text>"
			    & "<line x1='16' y1='88' x2='320' y2='88' stroke='#E3E7EF'/>"
			    & "<text x='16' y='107' font-size='11.5' fill='#4A5768'>" & "Orders " & FORMAT([Orders], "#,0") & "</text><text x='320' y='107' font-size='11.5' font-weight='600' text-anchor='end' fill='" & IF(OP >= 0, "#1E7A4C", "#B3261E") & "'>" & IF(ISBLANK(OP), "new", IF(ABS(OP) >= 10, IF(OP > 0, ">+999%", "<-999%"), IF(OP < 0, "&#8722;", "+") & FORMAT(ABS(OP), "0.0%"))) & "</text>"
			    & "<text x='16' y='127' font-size='11.5' fill='#4A5768'>" & "Average order " & "$" & FORMAT([Average Order Value], "#,0") & "</text><text x='320' y='127' font-size='11.5' font-weight='600' text-anchor='end' fill='" & IF(AP >= 0, "#1E7A4C", "#B3261E") & "'>" & IF(ISBLANK(AP), "new", IF(ABS(AP) >= 10, IF(AP > 0, ">+999%", "<-999%"), IF(AP < 0, "&#8722;", "+") & FORMAT(ABS(AP), "0.0%"))) & "</text>"
			    & "<circle cx='286' cy='42' r='26' stroke='#E3E7EF' stroke-width='7' fill='none'/>" & IF(MIN(Ratio, 1) > 0, "<path d='M286,16 A26,26 0 " & IF(MIN(Ratio, 1) > 0.5, "1", "0") & " 1 " & FORMAT(286 + 26 * COS(2 * PI() * MIN(MIN(Ratio, 1), 0.9999) - PI() / 2), "0.00") & "," & FORMAT(42 + 26 * SIN(2 * PI() * MIN(MIN(Ratio, 1), 0.9999) - PI() / 2), "0.00") & "' stroke='#111F38' stroke-width='7' fill='none'/>") & IF(Ratio - 1 > 0, "<path d='M286,16 A26,26 0 " & IF(Ratio - 1 > 0.5, "1", "0") & " 1 " & FORMAT(286 + 26 * COS(2 * PI() * MIN(Ratio - 1, 0.9999) - PI() / 2), "0.00") & "," & FORMAT(42 + 26 * SIN(2 * PI() * MIN(Ratio - 1, 0.9999) - PI() / 2), "0.00") & "' stroke='#C9A227' stroke-width='7' fill='none'/>") & "<text x='286' y='47' font-size='13' font-weight='700' text-anchor='middle' fill='#0A0917'>" & FORMAT(Ratio, "0%") & "</text>"
			    & "</svg>"
			VAR NoComparison = "<svg xmlns='http://www.w3.org/2000/svg' width='336' height='140' viewBox='0 0 336 140' font-family='Segoe UI, sans-serif'><rect x='0.5' y='0.5' width='335' height='139' rx='4' fill='#FFFFFF' stroke='#E3E7EF'/><text x='16' y='24' font-size='11' font-weight='700' fill='#667284'>SALES</text><text x='16' y='64' font-size='13' fill='#4A5768'>No sales in " & [Comparison Year] & " to compare with.</text></svg>"
			RETURN
			    "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(IF([Comparison Available], Svg, NoComparison), "%", "%25"), "#", "%23")
		displayFolder: Revenue page
		dataCategory: ImageUrl
		lineageTag: b3e28504-5bf2-5c65-9c7d-677b86809c0e

	/// How many customers beat the comparison year, with the biggest move each way.
	measure 'Card Customers' =
			VAR C = [Comparison Year]
			VAR Above = [Customers Above Comparison]
			VAR InPlay = [Customers In Play]
			VAR Changes = ADDCOLUMNS(FILTER(ALL(Customer[Customer]), [Sales] + [Sales Comparison] > 0), "@Change", [Sales vs Comparison])
			VAR BestRow = TOPN(1, Changes, [@Change], DESC, Customer[Customer], ASC)
			VAR WorstRow = TOPN(1, Changes, [@Change], ASC, Customer[Customer], ASC)
			VAR BestName = SUBSTITUTE(SUBSTITUTE(MAXX(BestRow, Customer[Customer]), "&", "&amp;"), "<", "&lt;")
			VAR WorstName = SUBSTITUTE(SUBSTITUTE(MAXX(WorstRow, Customer[Customer]), "&", "&amp;"), "<", "&lt;")
			VAR BestValue = MAXX(BestRow, [@Change])
			VAR WorstValue = MAXX(WorstRow, [@Change])
			VAR Share = DIVIDE(Above, InPlay)
			VAR Svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='336' height='140' viewBox='0 0 336 140' font-family='Segoe UI, sans-serif'>"
			    & "<rect x='0.5' y='0.5' width='335' height='139' rx='4' fill='#FFFFFF' stroke='#E3E7EF'/><rect width='3' height='140' fill='#C9A227'/>"
			    & "<text x='16' y='24' font-size='11' font-weight='700' fill='#667284' letter-spacing='0.4'>" & "CUSTOMERS ABOVE " & C & "</text>"
			    & "<text x='16' y='58' font-size='28' font-weight='700' fill='#0A0917'>" & FORMAT(Above, "#,0") & "</text>"
			    & "<text x='16' y='76' font-size='11.5' fill='#667284'>" & "of " & FORMAT(InPlay, "#,0") & " who bought in either year" & "</text>"
			    & "<line x1='16' y1='88' x2='320' y2='88' stroke='#E3E7EF'/>"
			    & "<text x='16' y='107' font-size='11.5' fill='#4A5768'>" & "Biggest gain &#183; " & LEFT(BestName, 24) & "</text><text x='320' y='107' font-size='11.5' font-weight='600' text-anchor='end' fill='" & IF(BestValue >= 0, "#1E7A4C", "#B3261E") & "'>" & IF(BestValue < 0, "&#8722;$", "+$") & FORMAT(ABS(BestValue), "#,0") & "</text>"
			    & "<text x='16' y='127' font-size='11.5' fill='#4A5768'>" & "Biggest fall &#183; " & LEFT(WorstName, 24) & "</text><text x='320' y='127' font-size='11.5' font-weight='600' text-anchor='end' fill='" & IF(WorstValue >= 0, "#1E7A4C", "#B3261E") & "'>" & IF(WorstValue < 0, "&#8722;$", "+$") & FORMAT(ABS(WorstValue), "#,0") & "</text>"
			    & "<circle cx='286' cy='42' r='26' stroke='#E3E7EF' stroke-width='7' fill='none'/>" & IF(Share > 0, "<path d='M286,16 A26,26 0 " & IF(Share > 0.5, "1", "0") & " 1 " & FORMAT(286 + 26 * COS(2 * PI() * MIN(Share, 0.9999) - PI() / 2), "0.00") & "," & FORMAT(42 + 26 * SIN(2 * PI() * MIN(Share, 0.9999) - PI() / 2), "0.00") & "' stroke='#111F38' stroke-width='7' fill='none'/>") & "<text x='286' y='47' font-size='13' font-weight='700' text-anchor='middle' fill='#0A0917'>" & FORMAT(Share, "0%") & "</text>"
			    & "</svg>"
			VAR NoComparison = "<svg xmlns='http://www.w3.org/2000/svg' width='336' height='140' viewBox='0 0 336 140' font-family='Segoe UI, sans-serif'><rect x='0.5' y='0.5' width='335' height='139' rx='4' fill='#FFFFFF' stroke='#E3E7EF'/><text x='16' y='24' font-size='11' font-weight='700' fill='#667284'>CUSTOMERS</text><text x='16' y='64' font-size='13' fill='#4A5768'>No sales in " & [Comparison Year] & " to compare with.</text></svg>"
			RETURN
			    "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(IF([Comparison Available], Svg, NoComparison), "%", "%25"), "#", "%23")
		displayFolder: Revenue page
		dataCategory: ImageUrl
		lineageTag: 362216f6-f5ec-5b4a-84cc-18a9c0fcd856

	/// One tile per region, green above the comparison year and red below, alphabetical.
	measure 'Card Regions' =
			VAR C = [Comparison Year]
			VAR Regions = ADDCOLUMNS(FILTER(ALLSELECTED(Geography[Region]), [Sales] + [Sales Comparison] > 0), "@Change", [Sales vs Comparison], "@Pct", [Sales vs Comparison %])
			VAR N = COUNTROWS(Regions)
			VAR BestRow = TOPN(1, Regions, [@Change], DESC, Geography[Region], ASC)
			VAR WorstRow = TOPN(1, Regions, [@Change], ASC, Geography[Region], ASC)
			VAR BestValue = MAXX(BestRow, [@Change])
			VAR WorstValue = MAXX(WorstRow, [@Change])
			VAR BestPct = MAXX(BestRow, [@Pct])
			VAR WorstPct = MAXX(WorstRow, [@Pct])
			VAR Tiles =
			    CONCATENATEX(
			        Regions,
			        VAR RegionName = Geography[Region]
			        VAR I = COUNTROWS(FILTER(Regions, Geography[Region] < RegionName))
			        VAR X = 176 + I * 38
			        RETURN
			            "<rect x='" & X & "' y='22' width='32' height='40' rx='3' fill='" & IF([@Change] >= 0, "#1E7A4C", "#B3261E") & "'/>"
			                & "<text x='" & X + 16 & "' y='40' font-size='10' font-weight='700' text-anchor='middle' fill='#FFFFFF'>" & LEFT(RegionName, 1) & "</text>"
			                & "<text x='" & X + 16 & "' y='55' font-size='9' text-anchor='middle' fill='#FFFFFF'>"
			                & IF(ISBLANK([@Pct]), "new", IF([@Pct] < 0, "-", "+") & FORMAT(ABS([@Pct]), "0%")) & "</text>",
			        ""
			    )
			VAR Svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='336' height='140' viewBox='0 0 336 140' font-family='Segoe UI, sans-serif'>"
			    & "<rect x='0.5' y='0.5' width='335' height='139' rx='4' fill='#FFFFFF' stroke='#E3E7EF'/><rect width='3' height='140' fill='#C9A227'/>"
			    & "<text x='16' y='24' font-size='11' font-weight='700' fill='#667284' letter-spacing='0.4'>" & "REGIONS ABOVE " & C & "</text>"
			    & "<text x='16' y='58' font-size='28' font-weight='700' fill='#0A0917'>" & FORMAT([Regions Above Comparison], "0") & "</text>"
			    & "<text x='16' y='76' font-size='11.5' fill='#667284'>" & "of " & N & IF(N = 1, " region", " regions") & "</text>"
			    & "<line x1='16' y1='88' x2='320' y2='88' stroke='#E3E7EF'/>"
			    & "<text x='16' y='107' font-size='11.5' fill='#4A5768'>" & "Best &#183; " & MAXX(BestRow, Geography[Region]) & "</text><text x='320' y='107' font-size='11.5' font-weight='600' text-anchor='end' fill='" & IF(BestValue >= 0, "#1E7A4C", "#B3261E") & "'>" & IF(BestValue < 0, "&#8722;$", "+$") & FORMAT(ABS(BestValue), "#,0") & " (" & IF(ISBLANK(BestPct), "new", IF(ABS(BestPct) >= 10, IF(BestPct > 0, ">+999%", "<-999%"), IF(BestPct < 0, "&#8722;", "+") & FORMAT(ABS(BestPct), "0.0%"))) & ")" & "</text>"
			    & "<text x='16' y='127' font-size='11.5' fill='#4A5768'>" & "Weakest &#183; " & MAXX(WorstRow, Geography[Region]) & "</text><text x='320' y='127' font-size='11.5' font-weight='600' text-anchor='end' fill='" & IF(WorstValue >= 0, "#1E7A4C", "#B3261E") & "'>" & IF(WorstValue < 0, "&#8722;$", "+$") & FORMAT(ABS(WorstValue), "#,0") & " (" & IF(ISBLANK(WorstPct), "new", IF(ABS(WorstPct) >= 10, IF(WorstPct > 0, ">+999%", "<-999%"), IF(WorstPct < 0, "&#8722;", "+") & FORMAT(ABS(WorstPct), "0.0%"))) & ")" & "</text>"
			    & Tiles
			    & "</svg>"
			VAR NoComparison = "<svg xmlns='http://www.w3.org/2000/svg' width='336' height='140' viewBox='0 0 336 140' font-family='Segoe UI, sans-serif'><rect x='0.5' y='0.5' width='335' height='139' rx='4' fill='#FFFFFF' stroke='#E3E7EF'/><text x='16' y='24' font-size='11' font-weight='700' fill='#667284'>REGIONS</text><text x='16' y='64' font-size='13' fill='#4A5768'>No sales in " & [Comparison Year] & " to compare with.</text></svg>"
			RETURN
			    "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(IF([Comparison Available], Svg, NoComparison), "%", "%25"), "#", "%23")
		displayFolder: Revenue page
		dataCategory: ImageUrl
		lineageTag: 1a66e5a9-dd8c-5957-93b3-8e9aea130718

	/// Every sub-category as a bar, sorted from the biggest gain to the biggest fall.
	measure 'Card Sub-categories' =
			VAR C = [Comparison Year]
			VAR Subs = ADDCOLUMNS(FILTER(ALL(Product[Sub-Category]), [Sales] + [Sales Comparison] > 0), "@Change", [Sales vs Comparison])
			VAR Scale = MAXX(Subs, ABS([@Change]))
			VAR BestRow = TOPN(1, Subs, [@Change], DESC, Product[Sub-Category], ASC)
			VAR WorstRow = TOPN(1, Subs, [@Change], ASC, Product[Sub-Category], ASC)
			VAR BestValue = MAXX(BestRow, [@Change])
			VAR WorstValue = MAXX(WorstRow, [@Change])
			VAR Bars =
			    "<line x1='206' y1='58' x2='320' y2='58' stroke='#E3E7EF'/>"
			        & CONCATENATEX(
			            Subs,
			            VAR Change = [@Change]
			            VAR I = COUNTROWS(FILTER(Subs, [@Change] > Change))
			            VAR H = MAX(1.5, 20 * DIVIDE(ABS(Change), Scale))
			            RETURN
			                "<rect x='" & FORMAT(206 + I * 6.8, "0.0") & "' y='" & FORMAT(IF(Change >= 0, 58 - H, 58), "0.0")
			                    & "' width='5' height='" & FORMAT(H, "0.0") & "' fill='" & IF(Change >= 0, "#1E7A4C", "#B3261E") & "'/>",
			            ""
			        )
			VAR Svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='336' height='140' viewBox='0 0 336 140' font-family='Segoe UI, sans-serif'>"
			    & "<rect x='0.5' y='0.5' width='335' height='139' rx='4' fill='#FFFFFF' stroke='#E3E7EF'/><rect width='3' height='140' fill='#C9A227'/>"
			    & "<text x='16' y='24' font-size='11' font-weight='700' fill='#667284' letter-spacing='0.4'>" & "SUB-CATEGORIES ABOVE " & C & "</text>"
			    & "<text x='16' y='58' font-size='28' font-weight='700' fill='#0A0917'>" & FORMAT([Sub-categories Above Comparison], "0") & "</text>"
			    & "<text x='16' y='76' font-size='11.5' fill='#667284'>" & "of " & [Sub-categories In Play] & " sub-categories" & "</text>"
			    & "<line x1='16' y1='88' x2='320' y2='88' stroke='#E3E7EF'/>"
			    & "<text x='16' y='107' font-size='11.5' fill='#4A5768'>" & "Best &#183; " & MAXX(BestRow, Product[Sub-Category]) & "</text><text x='320' y='107' font-size='11.5' font-weight='600' text-anchor='end' fill='" & IF(BestValue >= 0, "#1E7A4C", "#B3261E") & "'>" & IF(BestValue < 0, "&#8722;$", "+$") & FORMAT(ABS(BestValue), "#,0") & "</text>"
			    & "<text x='16' y='127' font-size='11.5' fill='#4A5768'>" & "Weakest &#183; " & MAXX(WorstRow, Product[Sub-Category]) & "</text><text x='320' y='127' font-size='11.5' font-weight='600' text-anchor='end' fill='" & IF(WorstValue >= 0, "#1E7A4C", "#B3261E") & "'>" & IF(WorstValue < 0, "&#8722;$", "+$") & FORMAT(ABS(WorstValue), "#,0") & "</text>"
			    & Bars
			    & "</svg>"
			VAR NoComparison = "<svg xmlns='http://www.w3.org/2000/svg' width='336' height='140' viewBox='0 0 336 140' font-family='Segoe UI, sans-serif'><rect x='0.5' y='0.5' width='335' height='139' rx='4' fill='#FFFFFF' stroke='#E3E7EF'/><text x='16' y='24' font-size='11' font-weight='700' fill='#667284'>SUB-CATEGORIES</text><text x='16' y='64' font-size='13' fill='#4A5768'>No sales in " & [Comparison Year] & " to compare with.</text></svg>"
			RETURN
			    "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(IF([Comparison Available], Svg, NoComparison), "%", "%25"), "#", "%23")
		displayFolder: Revenue page
		dataCategory: ImageUrl
		lineageTag: d73028ed-fb49-5441-a1a5-2a4836d3c4c7

	/// 1 (quietest fifth of the cells on screen) to 5 (busiest); 0 for a cell with no sales;
	/// blank where the grid has no such cell. Rank-based so one outlier cannot flatten the rest.
	measure 'Cal Band Day' =
			VAR Me = [Sales]
			VAR Live = FILTER(CALCULATETABLE(ADDCOLUMNS(VALUES('Date'[Date]), "@v", [Sales]), ALLSELECTED('Date')), [@v] > 0)
			VAR N = COUNTROWS(Live)
			VAR Below = COUNTROWS(FILTER(Live, [@v] < Me))
			RETURN
			    IF(
			        HASONEVALUE('Date'[Date]),
			        IF(Me > 0, MIN(5, INT(DIVIDE(Below * 5, N - 1, 5)) + 1), 0)
			    )
		formatString: 0
		displayFolder: Calendar page
		lineageTag: 6d5a5c60-d96c-5df1-84b2-dcc532da2135

	/// Cell background for the band. Bound to the matrix's background colour.
	measure 'Cal Colour Day' =
			VAR Band = [Cal Band Day]
			RETURN
			    IF(NOT ISBLANK(Band), SWITCH(Band, 1, "#E6E9F1", 2, "#BCC1D2", 3, "#7C8598", 4, "#3E4A66", 5, "#111F38", "#F4F6FA"))
		displayFolder: Calendar page
		lineageTag: 99d0ad36-60a0-5e5d-8d26-01631641d1ec

	/// One calendar cell at the Day grain, drawn at 112x88: label top left, sales in the
	/// middle, orders bottom right, on the band's colour. A cell with no sales shows a dash.
	measure 'Cal Cell Day' =
			VAR Band = [Cal Band Day]
			VAR V = [Sales]
			VAR N = [Orders]
			VAR Fg = SWITCH(TRUE(), Band = 0, "#667284", Band >= 3, "#FFFFFF", "#0A0917")
			VAR Bg = [Cal Colour Day]
			VAR Svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='112' height='88' viewBox='0 0 112 88' font-family='Segoe UI, sans-serif'>"
			        & "<rect width='112' height='88' fill='" & Bg & "'/>"
			        & "<text x='8' y='17' font-size='11.5' font-weight='600' fill='" & Fg & "' opacity='0.85'>" & FORMAT(DAY(SELECTEDVALUE('Date'[Date])), "00") & "</text>"
			        & IF(
			            Band = 0,
			            "<text x='56' y='49' font-size='13' text-anchor='middle' fill='#667284'>&#8211;</text>",
			            "<text x='56' y='50' font-size='17' font-weight='700' text-anchor='middle' fill='" & Fg & "'>" & SWITCH(TRUE(), V >= 1000000, "$" & FORMAT(V / 1000000, "0.00") & "M", V >= 10000, "$" & FORMAT(V / 1000, "0.0") & "k", V >= 1000, "$" & FORMAT(V / 1000, "0.00") & "k", "$" & FORMAT(V, "0")) & "</text>"
			                & "<text x='104' y='80' font-size='10.5' text-anchor='end' fill='" & Fg & "' opacity='0.8'>" & FORMAT(N, "#,0") & IF(N = 1, " order", " orders") & "</text>"
			        )
			        & "</svg>"
			RETURN
			    IF(NOT ISBLANK(Band), "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(Svg, "%", "%25"), "#", "%23"))
		displayFolder: Calendar page
		dataCategory: ImageUrl
		lineageTag: 8aea7131-a68d-5401-b078-40005ad38dd0

	/// 1 (quietest fifth of the cells on screen) to 5 (busiest); 0 for a cell with no sales;
	/// blank where the grid has no such cell. Rank-based so one outlier cannot flatten the rest.
	measure 'Cal Band Month' =
			VAR Me = [Sales]
			VAR Live = FILTER(CALCULATETABLE(ADDCOLUMNS(VALUES('Date'[Month No]), "@v", [Sales]), ALLSELECTED('Date')), [@v] > 0)
			VAR N = COUNTROWS(Live)
			VAR Below = COUNTROWS(FILTER(Live, [@v] < Me))
			RETURN
			    IF(
			        HASONEVALUE('Date'[Month No]),
			        IF(Me > 0, MIN(5, INT(DIVIDE(Below * 5, N - 1, 5)) + 1), 0)
			    )
		formatString: 0
		displayFolder: Calendar page
		lineageTag: 2c15a0d7-aa13-526d-ae65-7959b71c2770

	/// Cell background for the band. Bound to the matrix's background colour.
	measure 'Cal Colour Month' =
			VAR Band = [Cal Band Month]
			RETURN
			    IF(NOT ISBLANK(Band), SWITCH(Band, 1, "#E6E9F1", 2, "#BCC1D2", 3, "#7C8598", 4, "#3E4A66", 5, "#111F38", "#F4F6FA"))
		displayFolder: Calendar page
		lineageTag: cacb7a65-a9d1-5355-9b8b-8d17d46aeaac

	/// One calendar cell at the Month grain, drawn at 266x138: label top left, sales in the
	/// middle, orders bottom right, on the band's colour. A cell with no sales shows a dash.
	measure 'Cal Cell Month' =
			VAR Band = [Cal Band Month]
			VAR V = [Sales]
			VAR N = [Orders]
			VAR Fg = SWITCH(TRUE(), Band = 0, "#667284", Band >= 3, "#FFFFFF", "#0A0917")
			VAR Bg = [Cal Colour Month]
			VAR Svg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='266' height='138' viewBox='0 0 266 138' font-family='Segoe UI, sans-serif'>"
			        & "<rect width='266' height='138' fill='" & Bg & "'/>"
			        & "<text x='8' y='17' font-size='11.5' font-weight='600' fill='" & Fg & "' opacity='0.85'>" & SELECTEDVALUE('Date'[Month Short]) & "</text>"
			        & IF(
			            Band = 0,
			            "<text x='133' y='74' font-size='13' text-anchor='middle' fill='#667284'>&#8211;</text>",
			            "<text x='133' y='75' font-size='17' font-weight='700' text-anchor='middle' fill='" & Fg & "'>" & SWITCH(TRUE(), V >= 1000000, "$" & FORMAT(V / 1000000, "0.00") & "M", V >= 10000, "$" & FORMAT(V / 1000, "0.0") & "k", V >= 1000, "$" & FORMAT(V / 1000, "0.00") & "k", "$" & FORMAT(V, "0")) & "</text>"
			                & "<text x='258' y='130' font-size='10.5' text-anchor='end' fill='" & Fg & "' opacity='0.8'>" & FORMAT(N, "#,0") & IF(N = 1, " order", " orders") & "</text>"
			        )
			        & "</svg>"
			RETURN
			    IF(NOT ISBLANK(Band), "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(Svg, "%", "%25"), "#", "%23"))
		displayFolder: Calendar page
		dataCategory: ImageUrl
		lineageTag: 41a4368b-e94a-5ef5-b16a-811b32d17a3f

