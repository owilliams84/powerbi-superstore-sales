model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US

annotation PBI_QueryOrder = ["Date", "Customer", "Product", "Geography", "Ship Mode", "Sales"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

ref table Date
ref table Customer
ref table Product
ref table Geography
ref table 'Ship Mode'
ref table Sales
ref table Metrics
